# Site Configuration
NEXT_PUBLIC_SITE_URL=https://innovexle.com

# Analytics (optional - choose one)
# For Plausible: use your domain (e.g., innovexle.com)
# For Google Analytics: use your GA4 ID (e.g., G-XXXXXXXXXX)
# For Fathom: use your site ID (e.g., ABCDEFGH)
NEXT_PUBLIC_ANALYTICS_ID=

# Enable analytics debug logging in development
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Contact Form Email Delivery (REQUIRED for production)
# Get API key at https://resend.com - add to Vercel env vars for live site
# See CONTACT_SETUP.md for full checklist
RESEND_API_KEY=

# Optional: Use before domain verification. Set to onboarding@resend.dev to send
# immediately without verifying innovexle.com. Remove once domain is verified.
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Email recipient(s) for contact form submissions. Comma-separated for multiple copies.
CONTACT_EMAIL=hello@innovexle.com

# Error Monitoring (optional)
# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=
# Custom error reporting endpoint
NEXT_PUBLIC_ERROR_ENDPOINT=

# Web Vitals (optional)
# Endpoint for Core Web Vitals reporting
NEXT_PUBLIC_VITALS_ENDPOINT=

# Search Console Verification (optional)
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=

# Supabase (for job applications & resume storage)
# Get these from https://supabase.com/dashboard/project/_/settings/api
# See SUPABASE_SETUP.md for full setup guide
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API key for fetching applications (GET /api/applications)
# Required in production. Use: Authorization: Bearer <key> or X-API-Key: <key>
APPLICATIONS_API_KEY=
