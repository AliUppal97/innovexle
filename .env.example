# Site Configuration
NEXT_PUBLIC_SITE_URL=https://innovexle.com

# Analytics (optional - choose one)
# For Plausible: use your domain (e.g., innovexle.com)
# For Google Analytics: use your GA4 ID (e.g., G-XXXXXXXXXX)
# For Fathom: use your site ID (e.g., ABCDEFGH)
NEXT_PUBLIC_ANALYTICS_ID=

# Enable analytics debug logging in development
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Contact Form Email Delivery (optional)
# Email delivery via Resend (recommended - https://resend.com)
RESEND_API_KEY=

# Email recipient for contact form submissions
CONTACT_EMAIL=hello@innovexle.com

# Error Monitoring (optional)
# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=
# Custom error reporting endpoint
NEXT_PUBLIC_ERROR_ENDPOINT=

# Web Vitals (optional)
# Endpoint for Core Web Vitals reporting
NEXT_PUBLIC_VITALS_ENDPOINT=

# Search Console Verification (optional)
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
